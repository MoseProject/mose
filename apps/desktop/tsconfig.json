{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "isolatedModules": true,
    "skipLibCheck": true,
    "noEmit": true,
    "types": ["vite/client"],
    "paths": {
      "@/*": ["./src/*"],
      "@components/*": ["./src/editor/*"],
      "@tests/*": ["./tests/*"],
      "@stories/*": ["./stories/*"]
    }
  },
  "include": [
    "src",
    "tests",
    "stories",
    ".storybook",
    "visual",
    "vite.config.ts",
    "playwright.config.ts"
  ]
}
